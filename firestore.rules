rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Project: geosoft-agents-customer-whc5sa (Standard edition, (default) database)
// Auth Model: Firebase Authentication Email/Password ONLY (sign_in_provider == 'password').
//             Each teacher username (^[a-z0-9][a-z0-9._-]{2,31}$) maps to synthetic email
//             <username>@teachers.answer.ge. email_verified is NOT required.
//             User creation, password resets, forced 1-time password completion, and user
//             deletion are performed server-side via Firebase Admin SDK in Cloud Run.
//
// 1. Collection: /teachers/{teacherUsername}
//    Document ID: {teacherUsername} - Canonical lowercase username matching
//                 ^[a-z0-9][a-z0-9._-]{2,31}$ (3..32 chars).
//    Allowed Fields:
//      - username:           string    (optional on Console-bootstrapped docs, immutable for
//                                       clients, 3..32 chars, must equal {teacherUsername})
//      - role:               string    (required, immutable for clients,
//                                       enum: ['teacher', 'super_admin'])
//      - mustChangePassword: bool      (optional on Console-bootstrapped docs, immutable for
//                                       clients; when true, blocks workspace & admin actions
//                                       until updated server-side via Admin SDK)
//      - addedBy:            string    (optional/null, immutable for clients, 0..254 chars)
//      - addedAt:            timestamp (optional/null, immutable for clients)
//      - note:               string    (optional, 0..160 chars; modifiable only by active
//                                       Super Admin)
//      - displayName:        string    (optional, 0..120 chars; modifiable only by active
//                                       Super Admin)
//      - lastLoginAt:        timestamp (optional/null; modifiable by active teacher/admin on
//                                       self check-in, must equal request.time)
//      - passwordChangedAt:  timestamp (optional/null, immutable for clients; Admin SDK only)
//      - passwordResetAt:    timestamp (optional/null, immutable for clients; Admin SDK only)
//      - passwordResetBy:    string    (optional/null, immutable for clients, 0..254 chars;
//                                       Admin SDK only)
//
// 2. Subcollection: /teachers/{teacherUsername}/docs/{docKey}
//    Document ID: {docKey} - Safe URL/document identifier (1..128 chars, ^[A-Za-z0-9_-]+$).
//    Fields:
//      - docKey:       string    (required, immutable, 1..128 chars, must equal {docKey},
//                                 matches ^[A-Za-z0-9_-]+$)
//      - docUrl:       string    (required, immutable, 7..1024 chars, matches ^(https://|local:).*
//                                 supporting https Google Docs/Drive links and local: uploads)
//      - studentQrUrl: string    (required, 10..1200 chars, matches ^https?://.*)
//      - title:        string    (required, 1..200 chars)
//      - status:       string    (required, enum: ['qr_shared', 'ai_generated'])
//      - createdAt:    timestamp (required, immutable; on create must equal request.time)
//      - updatedAt:    timestamp (required; on create and update must equal request.time)
//      - subject:      string    (optional, 0..120 chars)
//      - classLabel:   string    (optional, 0..80 chars)
//      - personalNote: string    (optional, 0..300 chars)
//      - shareCount:   int       (optional, 0..100000)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Standard & Authentication Helper Functions
    // ===============================================================

    // Check if the request comes from an authenticated Firebase Auth user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns a resource by Firebase Auth UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify UID field is untampered on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
             request.resource.data.uid == request.auth.uid;
    }

    // Verify UID field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
             request.resource.data.uid == resource.data.uid;
    }

    // Validate canonical teacher username format (3..32 chars)
    function isValidUsername(username) {
      return username is string &&
             username.size() >= 3 &&
             username.size() <= 32 &&
             username.matches("^[a-z0-9][a-z0-9._-]{2,31}$");
    }

    // Verify caller signed in with Firebase Email/Password provider using a valid
    // synthetic teacher email (<username>@teachers.answer.ge). Does NOT require email_verified.
    function isPasswordAuthUser() {
      return request.auth != null &&
             'firebase' in request.auth.token &&
             request.auth.token.firebase is map &&
             'sign_in_provider' in request.auth.token.firebase &&
             request.auth.token.firebase.sign_in_provider == 'password' &&
             'email' in request.auth.token &&
             request.auth.token.email is string &&
             request.auth.token.email.lower().matches("^[a-z0-9][a-z0-9._-]{2,31}@teachers\\.answer\\.ge$");
    }

    // Extract canonical lowercase username from synthetic auth email (call when isPasswordAuthUser() is true)
    function callerUsername() {
      return request.auth.token.email.lower().split('@')[0];
    }

    // Check if caller's synthetic username matches target {teacherUsername}
    function isSelfUsername(teacherUsername) {
      return isPasswordAuthUser() &&
             isValidUsername(teacherUsername) &&
             callerUsername() == teacherUsername;
    }

    // ===============================================================
    // Role & Forced One-Time Password Change Helpers
    // ===============================================================

    function callerDocExists() {
      return exists(/databases/$(database)/documents/teachers/$(callerUsername()));
    }

    function callerDoc() {
      return get(/databases/$(database)/documents/teachers/$(callerUsername())).data;
    }

    // True when caller's teacher record requires a mandatory one-time password change
    function callerMustChangePassword() {
      return 'mustChangePassword' in callerDoc() &&
             callerDoc().mustChangePassword == true;
    }

    // True when caller is a password-authenticated Super Admin in /teachers/{callerUsername()}
    function isSuperAdmin() {
      return isPasswordAuthUser() &&
             callerDocExists() &&
             'role' in callerDoc() &&
             callerDoc().role == 'super_admin';
    }

    // True when Super Admin has completed any required one-time password change
    function isActiveSuperAdmin() {
      return isSuperAdmin() && !callerMustChangePassword();
    }

    // True when caller owns {teacherUsername}, holds an active 'teacher' or 'super_admin'
    // role in /teachers/{callerUsername()}, and does NOT have mustChangePassword == true
    function isActiveAuthorizedTeacher(teacherUsername) {
      return isSelfUsername(teacherUsername) &&
             callerDocExists() &&
             'role' in callerDoc() &&
             callerDoc().role in ['teacher', 'super_admin'] &&
             !callerMustChangePassword();
    }

    // ===============================================================
    // Schema & Field Validation Helpers
    // ===============================================================

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidUrl(url) {
      return url is string &&
             url.matches("^https?://.*");
    }

    // Validate shared lesson document URL (supports https:// Google Docs/Drive links and local: uploads)
    function isValidLessonDocUrl(url) {
      return url is string &&
             url.size() >= 7 &&
             url.size() <= 1024 &&
             url.matches("^(https://|local:).*");
    }

    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) ||
             (data[field] is string &&
              data[field].size() >= minLen &&
              data[field].size() <= maxLen);
    }

    function isValidOptionalStringOrNull(data, field, minLen, maxLen) {
      return !(field in data) ||
             data[field] == null ||
             (data[field] is string &&
              data[field].size() >= minLen &&
              data[field].size() <= maxLen);
    }

    function isValidOptionalTimestampOrNull(data, field) {
      return !(field in data) ||
             data[field] == null ||
             data[field] is timestamp;
    }

    function isValidOptionalInt(data, field, minVal, maxVal) {
      return !(field in data) ||
             (data[field] is int &&
              data[field] >= minVal &&
              data[field] <= maxVal);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Validates resulting /teachers/{teacherUsername} document state (accommodating
    // optional/null server-managed audit fields on Console/Admin-SDK created records)
    function isValidTeacherDoc(data, teacherUsername) {
      let requiredFields = ['role'];
      let allowedFields = [
        'username',
        'role',
        'mustChangePassword',
        'addedBy',
        'addedAt',
        'note',
        'displayName',
        'lastLoginAt',
        'passwordChangedAt',
        'passwordResetAt',
        'passwordResetBy'
      ];

      return isValidUsername(teacherUsername) &&
             hasRequiredFields(data, requiredFields) &&
             hasOnlyAllowedFields(data, allowedFields) &&
             data.role is string &&
             data.role in ['teacher', 'super_admin'] &&
             (!('username' in data) ||
              (data.username is string &&
               data.username == teacherUsername &&
               isValidUsername(data.username))) &&
             (!('mustChangePassword' in data) || data.mustChangePassword is bool) &&
             isValidOptionalStringOrNull(data, 'addedBy', 0, 254) &&
             isValidOptionalTimestampOrNull(data, 'addedAt') &&
             isValidOptionalStringOrNull(data, 'note', 0, 160) &&
             isValidOptionalStringOrNull(data, 'displayName', 0, 120) &&
             isValidOptionalTimestampOrNull(data, 'lastLoginAt') &&
             isValidOptionalTimestampOrNull(data, 'passwordChangedAt') &&
             isValidOptionalTimestampOrNull(data, 'passwordResetAt') &&
             isValidOptionalStringOrNull(data, 'passwordResetBy', 0, 254);
    }

    // Branch A: Active Super Admin updating teacher note and/or displayName ONLY
    function isValidAdminTeacherUpdate(teacherUsername) {
      let immutableFields = [
        'username',
        'role',
        'mustChangePassword',
        'addedBy',
        'addedAt',
        'lastLoginAt',
        'passwordChangedAt',
        'passwordResetAt',
        'passwordResetBy'
      ];

      return isActiveSuperAdmin() &&
             isValidTeacherDoc(request.resource.data, teacherUsername) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note', 'displayName']) &&
             areImmutableFieldsUnchanged(immutableFields) &&
             isValidOptionalString(request.resource.data, 'note', 0, 160) &&
             isValidOptionalString(request.resource.data, 'displayName', 0, 120);
    }

    // Branch B: Active authorized teacher updating ONLY lastLoginAt on login check-in
    function isValidTeacherSelfCheckin(teacherUsername) {
      let immutableFields = [
        'username',
        'role',
        'mustChangePassword',
        'addedBy',
        'addedAt',
        'note',
        'displayName',
        'passwordChangedAt',
        'passwordResetAt',
        'passwordResetBy'
      ];

      return isActiveAuthorizedTeacher(teacherUsername) &&
             isValidTeacherDoc(request.resource.data, teacherUsername) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']) &&
             areImmutableFieldsUnchanged(immutableFields) &&
             'lastLoginAt' in request.resource.data &&
             request.resource.data.lastLoginAt is timestamp &&
             request.resource.data.lastLoginAt == request.time;
    }

    // Personal saved lesson/document validator (used on BOTH create and update)
    function isValidSavedDoc(data, docKey) {
      let requiredFields = [
        'docKey',
        'docUrl',
        'studentQrUrl',
        'title',
        'status',
        'createdAt',
        'updatedAt'
      ];
      let allowedFields = [
        'docKey',
        'docUrl',
        'studentQrUrl',
        'title',
        'subject',
        'classLabel',
        'personalNote',
        'status',
        'shareCount',
        'createdAt',
        'updatedAt'
      ];

      return hasRequiredFields(data, requiredFields) &&
             hasOnlyAllowedFields(data, allowedFields) &&
             // docKey: safe identifier matching path {docKey}
             data.docKey is string &&
             data.docKey.size() >= 1 &&
             data.docKey.size() <= 128 &&
             data.docKey == docKey &&
             data.docKey.matches("^[A-Za-z0-9_-]+$") &&
             // docUrl: https:// Google Docs/Drive link or local: uploaded file
             isValidLessonDocUrl(data.docUrl) &&
             // studentQrUrl: bounded HTTP(S) student share link
             data.studentQrUrl is string &&
             data.studentQrUrl.size() >= 10 &&
             data.studentQrUrl.size() <= 1200 &&
             isValidUrl(data.studentQrUrl) &&
             // title: non-empty lesson title
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 200 &&
             // status: strict enum
             data.status is string &&
             data.status in ['qr_shared', 'ai_generated'] &&
             // timestamps
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             // optional teacher annotations & share telemetry
             isValidOptionalString(data, 'subject', 0, 120) &&
             isValidOptionalString(data, 'classLabel', 0, 80) &&
             isValidOptionalString(data, 'personalNote', 0, 300) &&
             isValidOptionalInt(data, 'shareCount', 0, 100000);
    }

    // ===============================================================
    // Collection Rules: /teachers/{teacherUsername}
    // ===============================================================

    match /teachers/{teacherUsername} {
      // Single-document lookup:
      // - Caller can ALWAYS read their own /teachers/{callerUsername()} doc (even when
      //   mustChangePassword == true) so the client can detect forced password change on login.
      // - Active Super Admin can read any teacher record.
      allow get: if isSelfUsername(teacherUsername) || isActiveSuperAdmin();

      // Collection listing / directory queries:
      // - Strictly restricted to active Super Admin (prevents teacher enumeration).
      allow list: if isActiveSuperAdmin();

      // Teacher creation & deletion are strictly server-side via Firebase Admin SDK
      // so Firebase Auth accounts, one-time passwords, and Firestore records stay atomic.
      allow create: if false;
      allow delete: if false;

      // Update teacher record:
      // - Branch A: Active Super Admin updating note/displayName only.
      // - Branch B: Active teacher updating lastLoginAt == request.time on login check-in.
      // - Security fields (role, mustChangePassword, username, password* audit fields)
      //   can NEVER be modified from the client.
      allow update: if isValidAdminTeacherUpdate(teacherUsername) ||
                       isValidTeacherSelfCheckin(teacherUsername);

      // =============================================================
      // Subcollection Rules: /teachers/{teacherUsername}/docs/{docKey}
      // =============================================================

      match /docs/{docKey} {
        // Active authorized teacher can read/list their own saved docs; active Super Admin can inspect.
        // Blocked while mustChangePassword == true.
        allow read: if isActiveAuthorizedTeacher(teacherUsername) || isActiveSuperAdmin();

        // Active authorized teacher can create a saved lesson record in their own workspace.
        allow create: if isActiveAuthorizedTeacher(teacherUsername) &&
                         isValidSavedDoc(request.resource.data, docKey) &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time;

        // Active authorized teacher can update mutable fields on their own saved doc,
        // keeping docKey, docUrl, and createdAt immutable and refreshing updatedAt.
        allow update: if isActiveAuthorizedTeacher(teacherUsername) &&
                         isValidSavedDoc(request.resource.data, docKey) &&
                         areImmutableFieldsUnchanged(['docKey', 'docUrl', 'createdAt']) &&
                         request.resource.data.docKey == resource.data.docKey &&
                         request.resource.data.docUrl == resource.data.docUrl &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.updatedAt == request.time;

        // Active authorized teacher can delete their own saved lesson record.
        allow delete: if isActiveAuthorizedTeacher(teacherUsername);
      }
    }

    // ===============================================================
    // Default Deny All Other Collections & Paths
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
